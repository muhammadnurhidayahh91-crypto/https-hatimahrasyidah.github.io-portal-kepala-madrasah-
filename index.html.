<style>
:root{--hijau:#075c3b;--gelap:#073b29;--emas:#d9b44a;--terang:#f4f7f3;--teks:#24372e}
*{box-sizing:border-box;scroll-behavior:smooth}
body{margin:0;font-family:Arial,Helvetica,sans-serif;color:var(--teks);line-height:1.7;background:#fff}
nav{background:var(--gelap);color:white;position:sticky;top:0;z-index:10}
.nav{max-width:1100px;margin:auto;padding:15px 22px;display:flex;align-items:center;justify-content:space-between;gap:20px}
.brand{font-weight:bold}.brand span{color:var(--emas)}
.links{display:flex;gap:18px;font-size:14px;flex-wrap:wrap}
a{color:inherit;text-decoration:none}.links a:hover{color:var(--emas)}
.hero{background:linear-gradient(135deg,#073b29,#087348);color:white;padding:85px 22px}
.wrap{max-width:1100px;margin:auto}
.hero-grid{display:grid;grid-template-columns:1.5fr .7fr;gap:40px;align-items:center}
.eyebrow{color:var(--emas);font-weight:bold;letter-spacing:2px}
h1{font-size:clamp(38px,6vw,62px);line-height:1.12;margin:12px 0}
.hero p{font-size:18px;color:#e3eee7;max-width:700px}
.pill{display:inline-block;border:1px solid #a6c6b3;border-radius:25px;padding:7px 15px;margin-top:12px}
.mark{height:240px;width:240px;max-width:100%;margin:auto;border:2px solid var(--emas);border-radius:50%;display:flex;align-items:center;justify-content:center;text-align:center;background:#ffffff12}
.mark strong{font-size:55px;color:var(--emas);display:block}
section{padding:65px 22px}
section:nth-of-type(even){background:var(--terang)}
h2{font-size:32px;color:var(--gelap);margin:0 0 10px}
.lead{color:#65746b;max-width:760px}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:28px}
.card{background:white;border-radius:15px;padding:24px;box-shadow:0 7px 25px #163b2510;border-top:4px solid var(--emas)}
.card h3{color:var(--hijau);margin-top:0}
.timeline{display:grid;gap:15px;margin-top:25px}
.item{background:white;border-left:5px solid var(--hijau);padding:18px 22px;border-radius:8px}
.contact{background:#f5f0df!important}
.contact-box{background:white;padding:28px;border-radius:15px}
.contact a{color:var(--hijau);font-weight:bold}
footer{background:var(--gelap);color:white;text-align:center;padding:25px 20px;font-size:14px}
footer span{color:var(--emas)}
@media(max-width:760px){.hero-grid{grid-template-columns:1fr}.mark{height:170px;width:170px}.cards{grid-template-columns:1fr}.links{gap:10px}.nav{align-items:flex-start;flex-direction:column}.hero{padding:60px 22px}section{padding:48px 22px}}
</style>
</head>
